{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "clavir-io.vercel.app" }],
      "destination": "https://clavir.io/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/apt/:path(.*)",
      "destination": "https://alexylon.github.io/clavirio/:path"
    }
  ]
}
